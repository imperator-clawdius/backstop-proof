// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id            String    @id @default(cuid())
  shopDomain    String    @unique
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  accessScope   String?
  plan          String    @default("FREE")
  settings      Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  proofCaptures   ProofCapture[]
  proofFiles      ProofFile[]
  evidencePacks   EvidencePack[]
  disputeSnapshots DisputeSnapshot[]
  auditEvents     AuditEvent[]
  notifications   Notification[]
}

model ProofCapture {
  id             String    @id @default(cuid())
  shopId         String
  shopifyOrderId String
  orderName      String
  status         String    @default("DRAFT")
  staffLabel     String?
  stationLabel   String?
  notes          String?
  sealedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  files         ProofFile[]
  evidencePacks EvidencePack[]

  @@index([shopId, shopifyOrderId])
  @@index([shopId, status])
}

model ProofFile {
  id                String   @id @default(cuid())
  proofCaptureId    String
  shopId            String
  storageKey        String
  originalFilename  String
  mimeType          String
  byteSize          Int
  sha256            String
  imageWidth        Int?
  imageHeight       Int?
  capturedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  proofCapture ProofCapture @relation(fields: [proofCaptureId], references: [id], onDelete: Cascade)
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, proofCaptureId])
  @@index([shopId, sha256])
}

model EvidencePack {
  id                String   @id @default(cuid())
  shopId            String
  shopifyOrderId    String
  orderName         String
  disputeId         String?
  proofCaptureId    String?
  status            String   @default("GENERATED")
  pdfStorageKey     String
  rebuttalText      String
  completenessScore Int
  missingItems      Json
  rawSnapshot       Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  proofCapture ProofCapture? @relation(fields: [proofCaptureId], references: [id], onDelete: SetNull)

  @@index([shopId, shopifyOrderId])
  @@index([shopId, disputeId])
}

model DisputeSnapshot {
  id               String   @id @default(cuid())
  shopId           String
  shopifyDisputeId String
  shopifyOrderId   String?
  orderName        String?
  status           String
  reason           String
  amount           String
  currency         String
  evidenceDueBy    DateTime?
  raw              Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyDisputeId])
  @@index([shopId, status])
  @@index([shopId, evidenceDueBy])
}

model AuditEvent {
  id         String   @id @default(cuid())
  shopId     String
  entityType String
  entityId   String
  actorType  String   @default("SYSTEM")
  actorLabel String?
  action     String
  metadata   Json
  createdAt  DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, entityType, entityId])
  @@index([shopId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  shopId    String
  type      String
  title     String
  body      String
  status    String    @default("UNREAD")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([shopId, type])
}
